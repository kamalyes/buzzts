{
    "name": "buzzts",
    "version": "0.0.17",
    "description": "一个短小而精悍的现代JavaScript/TypeScript使用工具库",
    "main": "dist/index.cjs.js",
    "module": "dist/index.esm.js",
    "unpkg": "dist/index.umd.js",
    "jsdelivr": "dist/index.umd.js",
    "types": "dist/index.d.ts",
    "jsname": "buzzts",
    "scripts": {
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "dev": " cross-env NODE_ENV=dev rollup -c -w",
        "build": "rimraf dist && cross-env NODE_ENV=production rollup -c",
        "build:analyze": "cross-env ANALYZE=true npm run build",
        "release": "pnpx semantic-release",
        "lint": "eslint . --ext .ts,.tsx,.js",
        "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\""
    },
    "homepage": "",
    "bugs": "https://github.com/kamalyes/buzzts/issues",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/kamalyes/buzzts.git"
    },
    "author": "Kamalyes",
    "license": "Apache-2.0",
    "files": [
        "dist",
        "types",
        "index.js"
    ],
    "keywords": [
        "buzzts",
        "typescript",
        "es6",
        "browser",
        "mathx",
        "datetime",
        "random",
        "dom",
        "storage",
        "typed",
        "validator"
    ],
    "engines": {
        "node": "^18.0.0 || >=20.0.0",
        "pnpm": ">=8.6.10"
    },
    "devDependencies": {
        "@babel/core": "^7.21.0",
        "@babel/preset-env": "^7.20.2",
        "@rollup/plugin-commonjs": "^16.0.0",
        "@rollup/plugin-json": "^4.1.0",
        "@rollup/plugin-node-resolve": "^10.0.0",
        "@types/jest": "^30.0.0",
        "@typescript-eslint/eslint-plugin": "8.35.0",
        "@typescript-eslint/parser": "8.35.0",
        "babel-jest": "^30.0.4",
        "cross-env": "^7.0.3",
        "eslint": "^8.57.0",
        "eslint-plugin-prettier": "^3.4.1",
        "jest": "^30.0.4",
        "jest-environment-jsdom": "^30.0.2",
        "prettier": "^2.8.8",
        "rimraf": "^4.1.2",
        "rollup": "^2.79.1",
        "rollup-plugin-babel": "^4.4.0",
        "rollup-plugin-delete": "^2.0.0",
        "rollup-plugin-dts": "^3.0.2",
        "rollup-plugin-gzip": "^3.1.0",
        "rollup-plugin-livereload": "^2.0.5",
        "rollup-plugin-serve": "^1.1.0",
        "rollup-plugin-styles": "^4.0.0",
        "rollup-plugin-terser": "^7.0.2",
        "rollup-plugin-typescript2": "^0.36.0",
        "rollup-plugin-visualizer": "^6.0.3",
        "ts-jest": "^29.4.0",
        "typescript": "^4.9.5"
    }
}
